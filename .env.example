# Environment: "dev" or "prod"
APP_ENVIRONMENT=dev

# Database Configuration
POSTGRES_DB=secondbrain
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://secondbrain:replace-with-a-long-random-password@localhost:5432/secondbrain

# MinIO Storage Configuration
MINIO_ROOT_USER=secondbrain
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_ENDPOINT=http://localhost:9000

# Frontend Configuration
APP_ORIGIN=http://localhost:5173

# Authentication Configuration
# Generate JWT secret: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial User (Change immediately after first login!)
INITIAL_USER_USERNAME=manuel
INITIAL_USER_EMAIL=test@example.com
INITIAL_USER_PASSWORD=change-me-immediately

# TOTP Encryption Key (Fernet key for encrypted TOTP storage)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Separate Fernet key for Finance connector credentials and external references.
# Generate with the same command above; do not reuse the TOTP or Google key.
FINANCE_ENCRYPTION_KEY=
FINANCE_SCAN_TIMEOUT_SECONDS=30
FINANCE_OCR_TIMEOUT_SECONDS=30
FINANCE_GUIDANCE_FETCH_TIMEOUT_SECONDS=10
# Production startup refreshes the official ClamAV signature database and fails closed.
FINANCE_CLAMAV_UPDATE_TIMEOUT_SECONDS=60

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5

# OpenRouter AI (food photo analysis) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Google Calendar sync ---
# OAuth client from Google Cloud Console (APIs & Services -> Credentials).
# Enable the "Google Calendar API", create an "OAuth client ID" (Web application),
# and add the redirect URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Fernet key used to encrypt Google refresh tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Frontend origin the OAuth callback redirects back to.
FRONTEND_URL=http://localhost:5173

# Background sync cadence for Google/ICS calendars (minutes).
CALENDAR_SYNC_INTERVAL_MINUTES=15
