{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinanceAssistantAnswer",
  "type": "object",
  "required": [
    "answer",
    "asOf",
    "claims",
    "uncertainties",
    "actions"
  ],
  "properties": {
    "answer": {
      "type": "string"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "basis",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": [
              "ledger",
              "calculation",
              "web",
              "inference"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "type",
          "requiresConfirmation"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "requiresConfirmation": {
            "type": "boolean"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
