{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain.local/schemas/financial-event.schema.json",
  "title": "FinancialEventRevision",
  "type": "object",
  "required": [
    "eventId",
    "revision",
    "eventType",
    "effectiveAt",
    "sourceAccountId",
    "components",
    "provenance"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "transfer",
        "trade",
        "staking_reward",
        "interest",
        "dividend",
        "funding_payment",
        "derivative_fill",
        "fee",
        "withholding",
        "corporate_action",
        "valuation_adjustment",
        "other"
      ]
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceLocalTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceTimezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceAccountId": {
      "type": "string",
      "format": "uuid"
    },
    "externalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "confirmed",
        "superseded",
        "voided"
      ]
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "component": {
      "type": "object",
      "required": [
        "role",
        "assetId",
        "quantity"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        },
        "quantity": {
          "$ref": "#/$defs/decimal"
        },
        "accountId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "rawRecordIds",
        "derivationType",
        "derivationVersion"
      ],
      "properties": {
        "rawRecordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "derivationType": {
          "type": "string"
        },
        "derivationVersion": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
